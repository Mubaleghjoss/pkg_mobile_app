<?xml version="1.0" encoding="utf-8"?>
<!-- Splash native Android: logo PKG di tengah latar krem. Tampil sebelum
     engine Flutter menggambar frame pertama, lalu disambung splash Flutter
     yang beranimasi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/pkg_splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
